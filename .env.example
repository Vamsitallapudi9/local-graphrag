# Copy to .env and fill in only what you need.
# Keys saved in the app (Projects -> Model settings) take priority over these.

# OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Claude (Anthropic): https://console.anthropic.com/settings/keys
# Leave empty to use your Claude Code login instead (needs the `claude` CLI).
ANTHROPIC_API_KEY=

# Gemini (Google): https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: a different local embedding model (any fastembed-supported model).
# Its vector size must match. Run `pnpm download-embeddings` after changing it.
# EMBED_MODEL=BAAI/bge-base-en-v1.5
# EMBED_DIMENSIONS=768

# Optional: parallel requests to cloud providers (default 4, Ollama 1).
# GRAPHRAG_CONCURRENT_REQUESTS=4
