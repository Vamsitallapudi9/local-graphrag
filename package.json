{
  "name": "local-graphrag",
  "version": "1.0.0",
  "description": "Turn documents into a 3D knowledge graph you can explore and ask questions.",
  "license": "MIT",
  "author": "Vamsi Tallapudi (https://github.com/Vamsitallapudi9)",
  "repository": {
    "type": "git",
    "url": "https://github.com/Vamsitallapudi9/local-graphrag.git"
  },
  "homepage": "https://github.com/Vamsitallapudi9/local-graphrag#readme",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack --hostname 127.0.0.1",
    "launch": "if [ ! -d node_modules ]; then pnpm install; fi && if [ ! -d .next ]; then pnpm build; fi && pnpm start",
    "build": "next build --turbopack",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "download-embeddings": "uv run --frozen python scripts/embed_server.py --download-only"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.13",
    "@react-three/drei": "^10.7.4",
    "@react-three/fiber": "^9.3.0",
    "@types/three": "^0.179.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "d3-force-3d": "^3.0.6",
    "lucide-react": "^0.542.0",
    "next": "16.2.10",
    "parquetjs-lite": "^0.8.7",
    "pdf-parse": "^1.1.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "tailwind-merge": "^3.3.1",
    "three": "^0.179.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.3.7",
    "typescript": "^5"
  }
}
